{
	"name": "@openmcp/sdk",
	"version": "0.0.1",
	"description": "OpenMCP SDK - Embeddable MCP Client for Node.js",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
